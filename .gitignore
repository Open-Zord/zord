# .env wins sobre .env.<entrypoint> e fica local-only (creds reais de homolog).
# Os .env.<entrypoint> (.env.http, .env.cli, .env.<queue>) SÃO versionados:
# servem de defaults de dev local. Não há padrão "ignora .env.*" — match
# literal só pega o nome exato ".env".
.env
.idea
storage
tmp/*
.DS-Store
.DS_Store
.vscode/
temp/
coverage.out
server

# stray artifacts
excalidraw.log
# binários de build na raiz (ancorados: não casar com cli/cmd/mcp)
/mcp
/zord
/zord-mcp
/http

# runtime materializado pelo gerador (cli/internal/runtimefs/sync); regenerável
cli/internal/runtimefs/_runtime/
